{
  "schema": "teos.manifest.v1",
  "name": "TEOS-AI-Auditor",
  "repo": "Elmahrosa/TEOS-AI-Auditor",
  "role": "Module",
  "status": "active",
  "version": "0.1.0",
  "authority": {
    "icbc": "https://github.com/Elmahrosa/International-Civic-Blockchain-Constitution",
    "tesl_canonical": "https://github.com/Elmahrosa/International-Civic-Blockchain-Constitution/blob/main/LICENSE"
  },
  "stewardship": {
    "teos_forge": "https://github.com/Elmahrosa/TEOS-FORGE",
    "kernel": "https://github.com/Elmahrosa/elmahrosa-core"
  },
  "interfaces": {
    "provides": ["audit.evidence.export", "audit.aggregation", "regulator.reports"],
    "consumes": ["kernel.registry", "governance.policy"]
  },
  "compliance": {
    "jurisdictions": ["EG"],
    "data_sensitivity": "internal",
    "controls": ["ICBC", "TESL_CANONICAL", "FORENSIC_LOGGING"]
  },
  "audit": {
    "events": ["evidence.exported", "audit.aggregated", "report.generated"],
    "evidence_export": { "formats": ["jsonl", "csv", "pdf"], "retention_days": 365 }
  },
  "contacts": { "owner": "Ayman Seif", "security": "ayman@teosegypt.com" }
}
